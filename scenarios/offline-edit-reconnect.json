{
  "id": "offline-edit-reconnect",
  "name": "Offline Edit and Reconnect",
  "description": "One device makes two edits while offline, reconnects, and syncs. Nothing may be lost.",
  "policy": "merge_non_overlapping_fields",
  "initial_state": {"id": "task-001", "status": "open", "notes": "Initial notes", "version": 1},
  "operations": [
    {"client": "device-A", "connection": "offline", "action": "update", "field": "status", "value": "completed"},
    {"client": "device-A", "connection": "offline", "action": "update", "field": "notes", "value": "Checked on site"},
    {"client": "device-A", "connection": "online", "action": "sync"}
  ],
  "expected_final_state": {"status": "completed", "notes": "Checked on site"},
  "assertions": ["status_matches_expected", "notes_matches_expected", "no_lost_updates", "all_operations_acknowledged"]
}
